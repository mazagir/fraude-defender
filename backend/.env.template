# Copia este archivo como backend/.env y completa los valores.
# Generar JWT: python -c "import secrets; print(secrets.token_hex(32))"

ENVIRONMENT=development
DB_PROVIDER=supabase

# Supabase → Project Settings → Database → Connection Pooling (Session mode, puerto 5432)
SUPABASE_DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres

# Solo si DB_PROVIDER=direct (Postgres local u otro host)
# DATABASE_URL=postgresql://admin:password@localhost:5432/aegis_db

JWT_SECRET_KEY=change-me-generate-with-secrets-token-hex-32
ALLOWED_API_KEYS=aegis_dev_api_key_2026

# Opcional: Google Gemini para análisis IA
# GEMINI_API_KEY=

# Opcional: Bot de WhatsApp vía Twilio (valida firma del webhook si se configura)
# TWILIO_AUTH_TOKEN=

# Producción en Render — orígenes del frontend (Vercel)
# BACKEND_CORS_ORIGINS=https://tu-app.vercel.app
# CORS_ALLOW_ORIGIN_REGEX=https://.*\.vercel\.app

# ── Configuración de correo electrónico ─────────────────────────────────────────
# From address for automated emails (usar dominio registrado, ej. no-reply@tudominio.com)
EMAILS_FROM=no-reply@agishield.com
# Servidor SMTP (soporta smtp.gmail.com, smtp.outlook.com, etc.)
EMAIL_HOST=smtp.gmail.com
# Puerto SMTP (587 para STARTTLS, 465 para SSL)
EMAIL_PORT=587
# Usuario SMTP (tu correo Gmail/Outlook)
EMAIL_USER=
# Contraseña o clave de aplicación del SMTP
EMAIL_PASSWORD=

# Dominios de correo permitidos para registro (separados por coma)
ALLOWED_EMAIL_DOMAINS=gmail.com,outlook.com,hotmail.com,yahoo.com

# ── SUPER_ADMIN ───────────────────────────────────────────────────────────────
# Genera un hash con: python -c "from passlib.context import CryptContext; print(CryptContext(schemes=['bcrypt'], deprecated='auto').hash('TU_CONTRASENA'))"
ADMIN_USER=admin
ADMIN_PASSWORD_HASH=
# Solo para el sembrado inicial: contraseña en claro (mínimo 12 caracteres).
# Nunca versione este valor; elimínelo del .env tras crear la cuenta.
ADMIN_PASSWORD_RAW=
